# Both Dockerfiles use `COPY . .`. Without this file every image would carry
# the developer's .env, the whole .git history and multi-GB model caches.

# Secrets — never bake credentials into an image layer
.env
.env.*
!.env.example

# Version control
.git
.gitignore
.github

# Local environments and caches
.venv
venv
env
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Model / data caches — re-downloaded or mounted at runtime
hf_cache
chroma_data
*.log
logs

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Test and docs assets are not needed to serve the app
tests
docs
